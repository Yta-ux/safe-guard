# SafeGuard Backend Environment Variables Example
PROJECT_NAME="SafeGuard Risk Classifier"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/safeguard_db"

# Google Gemini API Key for Grounded RAG Generation
GEMINI_API_KEY="your-gemini-api-key-here"

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80"]
